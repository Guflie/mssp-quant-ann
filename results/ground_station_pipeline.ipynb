        "    \"conflict_count\": phase_9_sample_evaluation[\"conflict_count\"],\n",
        "})\n",
        "\n",
        "print(\"\\nClassical exact comparison:\")\n",
        "print({\n",
        "    \"exact_objective_value\": phase_9_exact_comparison[\"exact_objective_value\"],\n",
        "    \"sampled_objective_value\": phase_9_exact_comparison[\"sampled_objective_value\"],\n",
        "    \"objective_gap\": phase_9_exact_comparison[\"objective_gap\"],\n",
        "    \"matches_exact_objective\": phase_9_exact_comparison[\"matches_exact_objective\"],\n",
        "    \"matches_exact_selected_set\": phase_9_exact_comparison[\"matches_exact_selected_set\"],\n",
        "})\n"
      ]
    },
    {
