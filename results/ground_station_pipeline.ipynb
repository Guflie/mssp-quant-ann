      "source": [
        "## Phase 3: Classical Reduction Core\n",
        "\n",
        "This phase implements the first safe reduction pipeline. It has two parts:\n",
        "\n",
        "- **Step 3A: constraint propagation**, which removes candidate slots that are deterministically infeasible.\n",
        "- **Step 3B: safe structural reductions**, which remove exact duplicates and locally dominated slots.\n",
        "\n",
        "No heuristic reductions are implemented in this phase."
      ]
    },
    {
      "cell_type": "markdown",
      "id": "196a0700",
      "metadata": {},
      "source": [
        "## Step 3A: Constraint Propagation\n",
        "\n",
        "The checks below are intentionally explicit. Each helper returns a Boolean and a short reason string so the reduction pipeline can report exactly why a slot was removed."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 257,
      "id": "7bf4f981",
      "metadata": {},
      "outputs": [],
      "source": [
        "def check_data_consistency(slot: CandidateSlot, horizon_start: float, horizon_end: float) -> tuple[bool, str]:\n",
        "    \"\"\"Check basic slot identifiers, numeric values, and horizon membership.\"\"\"\n",
        "    required_ids = [slot.slot_id, slot.satellite_id, slot.antenna_id, slot.station_id]\n",
        "    if any(not value for value in required_ids):\n",
        "        return False, \"missing identifier\"\n",
        "\n",
        "    numeric_values = [slot.start_time, slot.end_time, slot.priority, slot.urgency, slot.weight]\n",
        "    if any(not math.isfinite(value) for value in numeric_values):\n",
        "        return False, \"non-finite numeric value\"\n",
        "\n",
        "    if slot.priority < 0 or slot.urgency < 0:\n",
        "        return False, \"negative scoring input\"\n",
        "\n",
        "    if slot.end_time <= slot.start_time:\n",
        "        return False, \"invalid time order\"\n",
        "\n",
        "    if slot.start_time < horizon_start or slot.end_time > horizon_end:\n",
        "        return False, \"outside scheduling horizon\"\n",
        "\n",
        "    return True, \"ok\"\n",
        "\n",
        "\n",
        "def check_availability_consistency(\n",
        "    slot: CandidateSlot,\n",
        "    antenna_availability: Dict[str, tuple[float, float]],\n",
        ") -> tuple[bool, str]:\n",
        "    \"\"\"Check that a slot lies inside its antenna availability interval.\"\"\"\n",
        "    if slot.antenna_id not in antenna_availability:\n",
        "        return False, \"unknown antenna availability\"\n",
        "\n",
        "    available_start, available_end = antenna_availability[slot.antenna_id]\n",
        "    if slot.start_time < available_start or slot.end_time > available_end:\n",
        "        return False, \"outside antenna availability\"\n",
        "\n",
        "    return True, \"ok\"\n",
        "\n",
        "\n",
        "def check_blackout_consistency(\n",
        "    slot: CandidateSlot,\n",
        "    blackout_intervals: list[tuple[float, float]],\n",
        ") -> tuple[bool, str]:\n",
        "    \"\"\"Check that a slot does not overlap any blackout interval.\"\"\"\n",
        "    for blackout_start, blackout_end in blackout_intervals:\n",
        "        if intervals_overlap(slot.start_time, slot.end_time, blackout_start, blackout_end):\n",
        "            return False, \"overlaps blackout interval\"\n",
        "\n",
        "    return True, \"ok\"\n",
        "\n",
        "\n",
        "def check_duration_consistency(\n",
        "    slot: CandidateSlot,\n",
        "    min_duration: float,\n",
        "    max_duration: float | None = None,\n",
        ") -> tuple[bool, str]:\n",
        "    \"\"\"Check that a slot duration lies within the allowed duration limits.\"\"\"\n",
        "    if slot.duration < min_duration:\n",
        "        return False, \"below minimum duration\"\n",
        "\n",
        "    if max_duration is not None and slot.duration > max_duration:\n",
        "        return False, \"above maximum duration\"\n",
        "\n",
        "    return True, \"ok\"\n",
        "\n",
        "\n",
        "def check_local_transition_consistency(\n",
        "    slot: CandidateSlot,\n",
        "    fixed_contacts: list[CandidateSlot],\n",
        ") -> tuple[bool, str]:\n",
        "    \"\"\"Check that a slot leaves antenna-specific transition time around fixed contacts.\"\"\"\n",
        "    for fixed_contact in fixed_contacts:\n",
        "        if slot.antenna_id != fixed_contact.antenna_id:\n",
        "            continue\n",
        "\n",
        "        reconfiguration_time = max(\n",
        "            slot.antenna.reconfiguration_time,\n",
        "            fixed_contact.antenna.reconfiguration_time,\n",
        "        )\n",
        "\n",
        "        # Expanding the fixed contact captures direct overlap and setup time.\n",
        "        blocked_start = fixed_contact.start_time - reconfiguration_time\n",
        "        blocked_end = fixed_contact.end_time + reconfiguration_time\n",
        "        if intervals_overlap(slot.start_time, slot.end_time, blocked_start, blocked_end):\n",
        "            return False, \"conflicts with fixed contact transition time\"\n",
        "\n",
        "    return True, \"ok\"\n",
        "\n",
        "\n",
        "def apply_constraint_propagation(\n",
        "    slots: list[CandidateSlot],\n",
        "    horizon_start: float,\n",
        "    horizon_end: float,\n",
        "    antenna_availability: Dict[str, tuple[float, float]],\n",
        "    blackout_intervals: list[tuple[float, float]],\n",
        "    min_duration: float,\n",
        "    max_duration: float | None = None,\n",
        "    fixed_contacts: list[CandidateSlot] | None = None,\n",
        ") -> tuple[list[CandidateSlot], list[Dict[str, str]]]:\n",
        "    \"\"\"Remove candidate slots that deterministically violate hard constraints.\"\"\"\n",
        "    fixed_contacts = fixed_contacts or []\n",
        "    kept_slots = []\n",
        "    removed_slots = []\n",
        "\n",
        "    for slot in slots:\n",
        "        checks = [\n",
        "            check_data_consistency(slot, horizon_start, horizon_end),\n",
        "            check_availability_consistency(slot, antenna_availability),\n",
        "            check_blackout_consistency(slot, blackout_intervals),\n",
        "            check_duration_consistency(slot, min_duration, max_duration),\n",
        "            check_local_transition_consistency(slot, fixed_contacts),\n",
        "        ]\n",
        "\n",
        "        failed_check = next((check for check in checks if not check[0]), None)\n",
        "        if failed_check is None:\n",
        "            kept_slots.append(slot)\n",
        "        else:\n",
        "            removed_slots.append({\"slot_id\": slot.slot_id, \"reason\": failed_check[1]})\n",
        "\n",
        "    return kept_slots, removed_slots\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "16fd0dd4",
      "metadata": {},
      "source": [
        "## Step 3B: Safe Structural Reductions\n",
        "\n",
        "Two safe structural reductions are implemented here:\n",
        "\n",
        "- **Duplicate removal:** slots with the same satellite, antenna, station, and time interval are duplicates. The highest-weight copy is kept.\n",
        "- **Strong local dominance:** for the same satellite, antenna, and station, a shorter slot that is fully contained in a longer slot and has at least the same weight dominates the longer slot. The shorter slot is no worse in value and uses no more antenna time."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 258,
      "id": "960680ed",
      "metadata": {},
      "outputs": [],
      "source": [
        "def duplicate_key(slot: CandidateSlot) -> tuple[str, str, str, float, float]:\n",
        "    \"\"\"Return the key used to identify exact duplicate candidate slots.\"\"\"\n",
        "    return (slot.satellite_id, slot.antenna_id, slot.station_id, slot.start_time, slot.end_time)\n",
        "\n",
        "\n",
        "def remove_duplicate_slots(slots: list[CandidateSlot]) -> tuple[list[CandidateSlot], list[Dict[str, str]]]:\n",
        "    \"\"\"Remove exact duplicate slots, keeping the highest-weight copy.\"\"\"\n",
        "    best_slot_by_key = {}\n",
        "    removed_slots = []\n",
        "\n",
        "    for slot in slots:\n",
        "        key = duplicate_key(slot)\n",
        "        current_best = best_slot_by_key.get(key)\n",
        "\n",
        "        if current_best is None:\n",
        "            best_slot_by_key[key] = slot\n",
        "        elif slot.weight > current_best.weight:\n",
        "            removed_slots.append({\"slot_id\": current_best.slot_id, \"reason\": f\"duplicate of {slot.slot_id} with lower weight\"})\n",
        "            best_slot_by_key[key] = slot\n",
        "        else:\n",
        "            removed_slots.append({\"slot_id\": slot.slot_id, \"reason\": f\"duplicate of {current_best.slot_id} with lower or equal weight\"})\n",
        "\n",
        "    return list(best_slot_by_key.values()), removed_slots\n",
        "\n",
        "\n",
        "def slot_contains(outer_slot: CandidateSlot, inner_slot: CandidateSlot) -> bool:\n",
        "    \"\"\"Return True when `outer_slot` fully contains `inner_slot` in time.\"\"\"\n",
        "    return outer_slot.start_time <= inner_slot.start_time and outer_slot.end_time >= inner_slot.end_time\n",
        "\n",
        "\n",
        "def remove_strongly_dominated_slots(slots: list[CandidateSlot]) -> tuple[list[CandidateSlot], list[Dict[str, str]]]:\n",
        "    \"\"\"Remove locally dominated slots using a conservative containment rule.\"\"\"\n",
        "    dominated_slot_ids = set()\n",
        "    removed_slots = []\n",
        "\n",
        "    for possible_dominator in slots:\n",
        "        for possible_dominated in slots:\n",
        "            if possible_dominator.slot_id == possible_dominated.slot_id:\n",
        "                continue\n",
        "\n",
        "            same_local_resource = (\n",
        "                possible_dominator.satellite_id == possible_dominated.satellite_id\n",
        "                and possible_dominator.antenna_id == possible_dominated.antenna_id\n",
        "                and possible_dominator.station_id == possible_dominated.station_id\n",
        "            )\n",
        "            if not same_local_resource:\n",
        "                continue\n",
        "\n",
        "            dominator_uses_no_more_time = slot_contains(possible_dominated, possible_dominator)\n",
        "            dominator_is_no_worse = possible_dominator.weight >= possible_dominated.weight\n",
        "\n",
        "            if dominator_uses_no_more_time and dominator_is_no_worse:\n",
        "                if possible_dominated.slot_id not in dominated_slot_ids:\n",
        "                    dominated_slot_ids.add(possible_dominated.slot_id)\n",
        "                    removed_slots.append({\"slot_id\": possible_dominated.slot_id, \"reason\": f\"dominated by contained slot {possible_dominator.slot_id}\"})\n",
        "\n",
        "    kept_slots = [slot for slot in slots if slot.slot_id not in dominated_slot_ids]\n",
        "    return kept_slots, removed_slots\n",
        "\n",
        "\n",
        "def run_safe_reduction_pipeline(\n",
        "    slots: list[CandidateSlot],\n",
        "    horizon_start: float,\n",
        "    horizon_end: float,\n",
        "    antenna_availability: Dict[str, tuple[float, float]],\n",
        "    blackout_intervals: list[tuple[float, float]],\n",
        "    min_duration: float,\n",
        "    max_duration: float | None = None,\n",
        "    fixed_contacts: list[CandidateSlot] | None = None,\n",
        ") -> tuple[list[CandidateSlot], Dict[str, object]]:\n",
        "    \"\"\"Run Phase 3A and Phase 3B safe reductions in sequence.\"\"\"\n",
        "    after_constraint_propagation, constraint_removals = apply_constraint_propagation(\n",
        "        slots=slots,\n",
        "        horizon_start=horizon_start,\n",
        "        horizon_end=horizon_end,\n",
        "        antenna_availability=antenna_availability,\n",
        "        blackout_intervals=blackout_intervals,\n",
        "        min_duration=min_duration,\n",
        "        max_duration=max_duration,\n",
        "        fixed_contacts=fixed_contacts,\n",
        "        )\n",
        "    after_duplicate_removal, duplicate_removals = remove_duplicate_slots(after_constraint_propagation)\n",
        "    final_slots, dominance_removals = remove_strongly_dominated_slots(after_duplicate_removal)\n",
        "\n",
        "    report = {\n",
        "        \"input_size\": len(slots),\n",
        "        \"after_step_3a_size\": len(after_constraint_propagation),\n",
        "        \"after_duplicate_removal_size\": len(after_duplicate_removal),\n",
        "        \"final_size\": len(final_slots),\n",
        "        \"constraint_removals\": constraint_removals,\n",
        "        \"duplicate_removals\": duplicate_removals,\n",
        "        \"dominance_removals\": dominance_removals,\n",
        "    }\n",
        "    return final_slots, report\n"
      ]
    },
    {
