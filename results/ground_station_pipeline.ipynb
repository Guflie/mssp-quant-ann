    {
      "cell_type": "markdown",
      "id": "7b0c7b8f",
      "metadata": {},
      "source": [
        "## Phase 8: QPU-Suitable Subproblem Selection\n",
        "\n",
        "Phase 8 prepares QUBO subproblems that are small enough to send to a quantum annealing workflow in later phases. This phase only implements the first strategy from the implementation plan: connected-component decomposition.\n",
        "\n",
        "The key idea is that disconnected components of the conflict graph do not interact. If there is no edge between two components, selecting nodes in one component cannot create a conflict with nodes in the other component. That makes each connected component a natural independent subproblem."
      ]
    },
    {
      "cell_type": "markdown",
      "id": "843d7d5f",
      "metadata": {},
      "source": [
        "## Connected-Component Subproblem Functions\n",
        "\n",
        "These helpers extract connected components, compute descriptors for each induced subgraph, and rank/filter candidate subproblems using configurable size limits. The limits are intentionally parameters because actual QPU suitability depends on the hardware, embedding, and solver configuration used later."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 280,
      "id": "d1bea1de",
      "metadata": {},
      "outputs": [],
      "source": [
        "def sorted_connected_components_by_id(graph: nx.Graph) -> list[set[str]]:\n",
        "    \"\"\"Return connected components in deterministic order.\"\"\"\n",
        "    components = [set(component) for component in nx.connected_components(graph)]\n",
        "    return sorted(components, key=lambda component: sorted(component)[0])\n",
        "\n",
        "\n",
        "def edge_reason_counts(graph: nx.Graph) -> Dict[str, int]:\n",
        "    \"\"\"Count edge reasons inside a graph or subgraph.\"\"\"\n",
        "    reason_counts: Dict[str, int] = {}\n",
        "    for _, _, edge_data in graph.edges(data=True):\n",
        "        reason = edge_data.get(\"reason\", \"unknown\")\n",
        "        reason_counts[reason] = reason_counts.get(reason, 0) + 1\n",
        "\n",
        "    return dict(sorted(reason_counts.items()))\n",
        "\n",
        "\n",
        "def component_subgraph_descriptor(\n",
        "    component_id: str,\n",
        "    component_graph: nx.Graph,\n",
        ") -> Dict[str, object]:\n",
        "    \"\"\"Compute readable descriptors for one connected-component subproblem.\"\"\"\n",
        "    node_ids = sorted(component_graph.nodes)\n",
        "    node_count = component_graph.number_of_nodes()\n",
        "    edge_count = component_graph.number_of_edges()\n",
        "    degrees = dict(component_graph.degree())\n",
        "    weights = [component_graph.nodes[node_id][\"weight\"] for node_id in node_ids]\n",
        "    satellite_ids = {\n",
        "        component_graph.nodes[node_id].get(\"satellite_id\")\n",
        "        for node_id in node_ids\n",
        "        if component_graph.nodes[node_id].get(\"satellite_id\") is not None\n",
        "    }\n",
        "    antenna_ids = {\n",
        "        component_graph.nodes[node_id].get(\"antenna_id\")\n",
        "        for node_id in node_ids\n",
        "        if component_graph.nodes[node_id].get(\"antenna_id\") is not None\n",
        "    }\n",
        "    source_interval_ids = {\n",
        "        component_graph.nodes[node_id].get(\"source_interval_id\")\n",
        "        for node_id in node_ids\n",
        "        if component_graph.nodes[node_id].get(\"source_interval_id\") is not None\n",
        "    }\n",
        "\n",
        "    return {\n",
        "        \"component_id\": component_id,\n",
        "        \"node_count\": node_count,\n",
        "        \"edge_count\": edge_count,\n",
        "        \"density\": nx.density(component_graph),\n",
        "        \"average_degree\": 0.0 if node_count == 0 else sum(degrees.values()) / node_count,\n",
        "        \"max_degree\": 0 if not degrees else max(degrees.values()),\n",
        "        \"total_weight\": sum(weights),\n",
        "        \"max_weight\": None if not weights else max(weights),\n",
        "        \"satellite_count\": len(satellite_ids),\n",
        "        \"antenna_count\": len(antenna_ids),\n",
        "        \"source_interval_count\": len(source_interval_ids),\n",
        "        \"edge_reason_counts\": edge_reason_counts(component_graph),\n",
        "        \"qubo_variable_count\": node_count,\n",
        "        \"qubo_coupler_count\": edge_count,\n",
        "        \"node_ids\": node_ids,\n",
        "    }\n",
        "\n",
        "\n",
        "def mark_qpu_suitability(\n",
        "    descriptor: Dict[str, object],\n",
        "    max_variables: int,\n",
        "    max_couplers: int,\n",
        "    min_variables: int = 1,\n",
        ") -> Dict[str, object]:\n",
        "    \"\"\"Add QPU suitability flags to a subproblem descriptor.\"\"\"\n",
        "    reasons = []\n",
        "\n",
        "    if descriptor[\"node_count\"] < min_variables:\n",
        "        reasons.append(f\"below minimum variable count {min_variables}\")\n",
        "    if descriptor[\"node_count\"] > max_variables:\n",
        "        reasons.append(f\"exceeds max_variables={max_variables}\")\n",
        "    if descriptor[\"edge_count\"] > max_couplers:\n",
        "        reasons.append(f\"exceeds max_couplers={max_couplers}\")\n",
        "\n",
        "    descriptor = dict(descriptor)\n",
        "    descriptor[\"qpu_suitable\"] = len(reasons) == 0\n",
        "    descriptor[\"suitability_reasons\"] = reasons if reasons else [\"fits configured limits\"]\n",
        "    return descriptor\n",
        "\n",
        "\n",
        "def extract_connected_component_subproblems(\n",
        "    graph: nx.Graph,\n",
        "    max_variables: int,\n",
        "    max_couplers: int,\n",
        "    min_variables: int = 1,\n",
        "    penalty: float | None = None,\n",
        ") -> list[Dict[str, object]]:\n",
        "    \"\"\"Extract connected-component subproblems and build a QUBO for each one.\"\"\"\n",
        "    subproblems = []\n",
        "\n",
        "    for component_index, node_ids in enumerate(sorted_connected_components_by_id(graph), start=1):\n",
        "        component_id = f\"component_{component_index:03d}\"\n",
        "        component_graph = graph.subgraph(sorted(node_ids)).copy()\n",
        "        component_graph.graph[\"component_id\"] = component_id\n",
        "\n",
        "        descriptor = component_subgraph_descriptor(component_id, component_graph)\n",
        "        descriptor = mark_qpu_suitability(\n",
        "            descriptor,\n",
        "            max_variables=max_variables,\n",
        "            max_couplers=max_couplers,\n",
        "            min_variables=min_variables,\n",
        "        )\n",
        "        subproblem_qubo = build_mwis_qubo(\n",
        "            component_graph,\n",
        "            penalty=penalty if penalty is not None else default_mwis_penalty(component_graph),\n",
        "        )\n",
        "\n",
        "        subproblems.append(\n",
        "            {\n",
        "                \"component_id\": component_id,\n",
        "                \"graph\": component_graph,\n",
        "                \"descriptor\": descriptor,\n",
        "                \"qubo\": subproblem_qubo,\n",
        "            }\n",
        "        )\n",
        "\n",
        "    return subproblems\n",
        "\n",
        "\n",
        "def rank_qpu_subproblems(subproblems: list[Dict[str, object]]) -> list[Dict[str, object]]:\n",
        "    \"\"\"Rank suitable subproblems first, then prefer larger and higher-weight components.\"\"\"\n",
        "    return sorted(\n",
        "        subproblems,\n",
        "        key=lambda subproblem: (\n",
        "            subproblem[\"descriptor\"][\"qpu_suitable\"],\n",
        "            subproblem[\"descriptor\"][\"node_count\"],\n",
        "            subproblem[\"descriptor\"][\"total_weight\"],\n",
        "            subproblem[\"descriptor\"][\"edge_count\"],\n",
        "        ),\n",
        "        reverse=True,\n",
        "    )\n",
        "\n",
        "\n",
        "def format_subproblem_descriptor(\n",
        "    descriptor: Dict[str, object],\n",
        "    include_nodes: bool = False,\n",
        ") -> Dict[str, object]:\n",
        "    \"\"\"Return a compact descriptor for notebook display.\"\"\"\n",
        "    display_descriptor = dict(descriptor)\n",
        "    if not include_nodes:\n",
        "        display_descriptor.pop(\"node_ids\", None)\n",
        "\n",
        "    return display_descriptor\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "50cd8322",
      "metadata": {},
      "source": [
