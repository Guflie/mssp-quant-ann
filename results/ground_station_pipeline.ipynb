      "source": [
        "def conflict_graph_component_layout(graph: nx.Graph) -> Dict[str, tuple[float, float]]:\n",
        "    \"\"\"Create a spread-out deterministic layout for connected components.\"\"\"\n",
        "    positions = {}\n",
        "    components = sorted(\n",
        "        nx.connected_components(graph),\n",
        "        key=lambda component: (-len(component), sorted(component)),\n",
        "    )\n",
        "\n",
        "    if not components:\n",
        "        return positions\n",
        "\n",
        "    columns = 5\n",
        "    cell_width = 5.2\n",
        "    cell_height = 4.2\n",
        "\n",
        "    for component_index, component_nodes in enumerate(components):\n",
        "        subgraph = graph.subgraph(component_nodes)\n",
        "        row = component_index // columns\n",
        "        column = component_index % columns\n",
        "        x_offset = column * cell_width\n",
        "        y_offset = -row * cell_height\n",
        "\n",
        "        if subgraph.number_of_nodes() == 1:\n",
        "            node_id = next(iter(component_nodes))\n",
        "            positions[node_id] = (x_offset, y_offset)\n",
        "            continue\n",
        "\n",
        "        local_scale = max(1.2, math.sqrt(subgraph.number_of_nodes()) * 0.9)\n",
        "        local_positions = nx.spring_layout(\n",
        "            subgraph,\n",
        "            seed=42,\n",
        "            k=1.1,\n",
        "            scale=local_scale,\n",
        "            iterations=200,\n",
        "        )\n",
        "\n",
        "        for node_id, position in local_positions.items():\n",
        "            positions[node_id] = (position[0] + x_offset, position[1] + y_offset)\n",
        "\n",
        "    return positions\n",
        "\n",
        "\n",
        "def build_node_color_map(graph: nx.Graph, attribute: str = \"satellite_id\") -> tuple[list[str], dict[str, object]]:\n",
        "    \"\"\"Build deterministic node colors from a real graph node attribute.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    graph:\n",
        "        Conflict graph whose nodes contain candidate-slot metadata.\n",
        "    attribute:\n",
        "        Node attribute used for coloring, such as `satellite_id` or `antenna_id`.\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    tuple[list[str], dict[str, object]]\n",
        "        Node colors in graph-node order, plus a value-to-color mapping for legends.\n",
        "    \"\"\"\n",
        "    attribute_values = sorted({str(graph.nodes[node_id][attribute]) for node_id in graph.nodes})\n",
        "    if not attribute_values:\n",
        "        return [], {}\n",
        "\n",
        "    color_map = plt.get_cmap(\"tab20\", max(len(attribute_values), 1))\n",
        "    value_to_color = {\n",
        "        value: color_map(index)\n",
        "        for index, value in enumerate(attribute_values)\n",
        "    }\n",
        "    node_colors = [\n",
        "        value_to_color[str(graph.nodes[node_id][attribute])]\n",
        "        for node_id in graph.nodes\n",
        "    ]\n",
        "    return node_colors, value_to_color\n",
        "\n",
        "\n",
        "def add_color_legend(value_to_color: dict[str, object], title: str, max_entries: int = 32) -> None:\n",
        "    \"\"\"Add a compact legend for a dynamically generated color map.\"\"\"\n",
        "    if not value_to_color or len(value_to_color) > max_entries:\n",
        "        return\n",
        "\n",
        "    handles = [\n",
        "        plt.Line2D(\n",
        "            [0],\n",
        "            [0],\n",
        "            marker=\"o\",\n",
        "            color=\"w\",\n",
        "            markerfacecolor=color,\n",
        "            markeredgecolor=\"#1f2937\",\n",
        "            markersize=7,\n",
        "            label=value,\n",
        "        )\n",
        "        for value, color in value_to_color.items()\n",
        "    ]\n",
        "    plt.legend(\n",
        "        handles=handles,\n",
        "        title=title,\n",
        "        loc=\"center left\",\n",
        "        bbox_to_anchor=(1.01, 0.5),\n",
        "        fontsize=7,\n",
        "        title_fontsize=8,\n",
        "        frameon=False,\n",
        "    )\n",
        "\n",
        "\n",
        "def draw_conflict_graph(graph: nx.Graph, color_by: str = \"antenna_id\") -> None:\n",
        "    \"\"\"Draw a compact conflict graph colored by a real node attribute.\"\"\"\n",
        "    plt.figure(figsize=(18, 9))\n",
        "\n",
        "    positions = conflict_graph_component_layout(graph)\n",
        "    node_labels = {node_id: node_id for node_id in graph.nodes}\n",
        "    node_colors, value_to_color = build_node_color_map(graph, attribute=color_by)\n",
        "\n",
        "    nx.draw_networkx_edges(\n",
        "        graph,\n",
        "        positions,\n",
        "        width=1.1,\n",
        "        edge_color=\"#4b5563\",\n",
        "        alpha=0.45,\n",
        "    )\n",
        "    nx.draw_networkx_nodes(\n",
        "        graph,\n",
        "        positions,\n",
        "        node_size=520,\n",
        "        node_color=node_colors,\n",
        "        edgecolors=\"#1f2937\",\n",
        "        linewidths=0.9,\n",
        "    )\n",
        "    nx.draw_networkx_labels(\n",
        "        graph,\n",
        "        positions,\n",
        "        labels=node_labels,\n",
        "        font_size=6.5,\n",
        "        font_color=\"#111827\",\n",
        "    )\n",
        "\n",
        "    add_color_legend(value_to_color, title=color_by)\n",
        "    plt.title(f\"Phase 5 Conflict Graph colored by {color_by}\")\n",
        "    plt.axis(\"off\")\n",
        "    plt.margins(0.08)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "draw_conflict_graph(phase_5_graph, color_by=\"antenna_id\")\n"
      ]
    },
