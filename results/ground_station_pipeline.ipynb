      "source": [
        "phase_8_test_graph = nx.Graph()\n",
        "phase_8_test_graph.add_node(\"A\", weight=5.0)\n",
        "phase_8_test_graph.add_node(\"B\", weight=4.0)\n",
        "phase_8_test_graph.add_node(\"C\", weight=3.0)\n",
