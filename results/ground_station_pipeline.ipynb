      ],
      "source": [
        "def intervals_overlap(first_start: float, first_end: float, second_start: float, second_end: float) -> bool:\n",
        "    \"\"\"Return True when two half-open time intervals overlap.\"\"\"\n",
        "    return first_start < second_end and second_start < first_end\n",
        "\n",
        "\n",
        "def build_realistic_adapter_objects(slot_rows: pd.DataFrame) -> tuple[\n",
        "    list[CandidateSlot],\n",
        "    dict[str, Satellite],\n",
        "    dict[str, GroundStation],\n",
        "    dict[str, Antenna],\n",
        "]:\n",
        "    \"\"\"Build existing pipeline objects from Layer E candidate-slot rows.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    slot_rows:\n",
        "        Layer E candidate-slot table.\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    tuple\n",
        "        Candidate slots, satellites, ground stations, and antennas keyed by ID.\n",
        "    \"\"\"\n",
        "    ground_stations_by_id = {\n",
        "        station_id: GroundStation(id=station_id, name=group[\"station_name\"].iloc[0])\n",
        "        for station_id, group in slot_rows.groupby(\"station_id\", sort=True)\n",
        "    }\n",
        "    satellites_by_id = {\n",
        "        str(satellite_id): Satellite(id=str(satellite_id))\n",
        "        for satellite_id in sorted(slot_rows[\"satellite_id\"].astype(str).unique())\n",
        "    }\n",
        "    antennas_by_id = {}\n",
        "    for antenna_id, group in slot_rows.groupby(\"antenna_id\", sort=True):\n",
        "        station_id = group[\"station_id\"].iloc[0]\n",
        "        antennas_by_id[antenna_id] = Antenna(\n",
        "            id=antenna_id,\n",
        "            description=f\"Realistic gateway antenna {antenna_id}\",\n",
        "            station=ground_stations_by_id[station_id],\n",
        "            reconfiguration_time=float(group[\"reconfiguration_time_hours\"].iloc[0]),\n",
        "        )\n",
        "\n",
        "    candidate_slots = []\n",
        "    for row in slot_rows.itertuples(index=False):\n",
        "        satellite_id = str(row.satellite_id)\n",
        "        slot = CandidateSlot(\n",
