        "phase_9_sample_evaluation = phase_9_result[\"sample_evaluation\"]\n",
        "phase_9_exact_comparison = phase_9_result[\"exact_comparison\"]\n",
        "\n",
        "print(\"Phase 9 simulated annealing result:\")\n",
        "print({\n",
        "    \"backend\": phase_9_result[\"backend\"],\n",
        "    \"component_id\": phase_9_result[\"component_id\"],\n",
        "    \"num_reads\": phase_9_result[\"num_reads\"],\n",
        "    \"best_energy\": phase_9_result[\"best_energy\"],\n",
        "    \"num_occurrences\": phase_9_result[\"num_occurrences\"],\n",
        "})\n",
        "\n",
        "print(\"\\nDecoded selected nodes:\")\n",
        "print(sorted(phase_9_sample_evaluation[\"selected_node_ids\"]))\n",
        "\n",
        "print(\"\\nSample evaluation:\")\n",
        "print({\n",
        "    \"selected_node_count\": phase_9_sample_evaluation[\"selected_node_count\"],\n",
        "    \"objective_value\": phase_9_sample_evaluation[\"objective_value\"],\n",
        "    \"energy\": phase_9_sample_evaluation[\"energy\"],\n",
