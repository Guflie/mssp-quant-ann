        "\n",
        "    selected_node_ids = set(selected_node_ids)\n",
        "    non_selected_node_ids = [node_id for node_id in graph.nodes if node_id not in selected_node_ids]\n",
        "    selected_node_list = [node_id for node_id in graph.nodes if node_id in selected_node_ids]\n",
        "\n",
        "    selected_edges = [\n",
        "        (first_node, second_node)\n",
        "        for first_node, second_node in graph.edges\n",
        "        if first_node in selected_node_ids and second_node in selected_node_ids\n",
        "    ]\n",
        "    context_edges = [\n",
        "        (first_node, second_node)\n",
        "        for first_node, second_node in graph.edges\n",
