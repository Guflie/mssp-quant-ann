        "            start_time=float(row.start_time_hours),\n",
        "            end_time=float(row.end_time_hours),\n",
        "            priority=float(row.priority),\n",
        "            urgency=float(row.urgency),\n",
        "        )\n",
        "        slot.weight = float(row.weight)\n",
        "        candidate_slots.append(slot)\n",
        "\n",
        "    return candidate_slots, satellites_by_id, ground_stations_by_id, antennas_by_id\n",
        "\n",
        "\n",
        "phase_2_slots, satellites_by_id, ground_stations_by_id, antennas_by_id = build_realistic_adapter_objects(realistic_slot_rows)\n",
