      "source": [
        "REALISTIC_SLOT_DATASET_PATH = Path(\n",
        "    \"satellite-antenna-data/add-weight-data/starlink_scheduling_instance_dense.csv\"\n",
        ")\n",
        "# Other useful choices:\n",
        "# REALISTIC_SLOT_DATASET_PATH = Path(\"satellite-antenna-data/add-weight-data/starlink_scheduling_instance_small.csv\")\n",
        "# REALISTIC_SLOT_DATASET_PATH = Path(\"satellite-antenna-data/add-weight-data/starlink_scheduling_instance_medium.csv\")\n",
        "# REALISTIC_SLOT_DATASET_PATH = Path(\"satellite-antenna-data/add-weight-data/starlink_scheduling_instance_dense.csv\")\n",
        "\n",
        "\n",
        "def load_realistic_candidate_slot_rows(csv_path: Path) -> pd.DataFrame:\n",
        "    \"\"\"Load candidate slots generated by realistic data Layer E.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    csv_path:\n",
        "        Path to a Layer E candidate-slot CSV.\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    pandas.DataFrame\n",
        "        Candidate-slot rows with all fields needed to build adapter objects.\n",
        "    \"\"\"\n",
        "    if not csv_path.exists():\n",
        "        raise FileNotFoundError(f\"Missing realistic candidate-slot dataset: {csv_path}\")\n",
        "\n",
        "    rows = pd.read_csv(csv_path)\n",
        "    required_columns = {\n",
        "        \"slot_id\",\n",
        "        \"source_interval_id\",\n",
        "        \"satellite_id\",\n",
        "        \"antenna_id\",\n",
        "        \"station_id\",\n",
        "        \"station_name\",\n",
        "        \"start_time_hours\",\n",
        "        \"end_time_hours\",\n",
        "        \"priority\",\n",
        "        \"urgency\",\n",
        "        \"weight\",\n",
        "        \"reconfiguration_time_hours\",\n",
        "    }\n",
        "    missing_columns = required_columns - set(rows.columns)\n",
        "    if missing_columns:\n",
        "        raise ValueError(f\"Layer E dataset is missing required columns: {sorted(missing_columns)}\")\n",
        "\n",
        "    return rows\n",
        "\n",
        "\n",
        "realistic_slot_rows = load_realistic_candidate_slot_rows(REALISTIC_SLOT_DATASET_PATH)\n",
        "\n",
        "print(f\"Loaded {len(realistic_slot_rows)} realistic candidate slots from {REALISTIC_SLOT_DATASET_PATH}.\")\n",
        "print(f\"Unique parent windows: {realistic_slot_rows['source_interval_id'].nunique()}\")\n",
        "print(f\"Unique satellites: {realistic_slot_rows['satellite_id'].nunique()}\")\n",
        "print(f\"Unique antennas: {realistic_slot_rows['antenna_id'].nunique()}\")\n",
        "print(f\"Unique stations: {realistic_slot_rows['station_id'].nunique()}\")\n",
        "realistic_slot_rows.head()\n"
      ]
    },
